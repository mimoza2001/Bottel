{
  "buildCommand": "python3 scripts/process_h1b_data.py --seed && npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/salary/:company/:job",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/company/:slug",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/job/:slug",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
