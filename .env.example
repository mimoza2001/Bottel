# ============================================================
# Bottel — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# ── Trading APIs ─────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=

# ── Twitter / X ───────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# ── LinkedIn ──────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# ── Threads / Meta ────────────────────────────────────────────
THREADS_USERNAME=
THREADS_PASSWORD=

# ── Bluesky ───────────────────────────────────────────────────
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── General ───────────────────────────────────────────────────
LOG_LEVEL=INFO
