# Copy this file to .env.local and fill in your values

# Your site domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://h1bsalary.info

# Admin email for n8n workflow notifications
ADMIN_EMAIL=you@example.com

# Vercel deploy hook URL (get from: Vercel Dashboard → Project → Settings → Git → Deploy Hooks)
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/YOUR_HOOK_ID

# Google Search Console site URL (for SEO monitoring workflow)
GSC_SITE_URL=https://h1bsalary.info
